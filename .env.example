PORT=3333
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info
EXPO_PUBLIC_BACKEND_API_BASE_URL=http://127.0.0.1:3333

# Firebase Admin SDK settings
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or provide the pair below instead of FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional if you run the Firebase Auth emulator locally
FIREBASE_AUTH_EMULATOR_HOST=

# Expo client auth settings
# Google OAuth client IDs used by the Expo app for Google sign-in.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID is kept as a legacy fallback.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional placeholders for the backend foundation
DATABASE_URL=
BIBLE_API_KEY=
OPENAI_API_KEY=

# Comma-separated list of allowed origins, for example:
# http://localhost:8081,http://localhost:19006
CORS_ORIGINS=
