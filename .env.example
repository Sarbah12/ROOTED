PORT=3333
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info
EXPO_PUBLIC_BACKEND_API_BASE_URL=http://127.0.0.1:3333

# Firebase Admin SDK settings
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or provide the pair below instead of FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional if you run the Firebase Auth emulator locally
FIREBASE_AUTH_EMULATOR_HOST=

# Postgres (Supabase). Get this from the Supabase dashboard:
#   Connect -> Direct connection -> URI, then replace [YOUR-PASSWORD].
# Percent-encode any special characters in the password.
# Apply the schema with:  npm run migrate --prefix backend
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# API.Bible — licensed translations (NKJV, NLT, AMP …)
# Sign up at https://scripture.api.bible. The Starter plan is free, allows three
# copyrighted Bibles, and is STRICTLY NON-COMMERCIAL: no ads, fees, or upsells.
# Add ids to LICENSED_TRANSLATIONS in constants/bible-translations.ts, which you
# can read from GET /v1/bible/versions once this key is set.
API_BIBLE_KEY=

# Resend (transactional email: password reset, welcome)
# Get a key at https://resend.com/api-keys
# RESEND_FROM must use a domain you have verified in Resend, otherwise use
# their sandbox sender: "Rooted <onboarding@resend.dev>"
RESEND_API_KEY=
RESEND_FROM="Rooted <noreply@rootedbible.app>"
APP_PUBLIC_URL=https://rootedbible.app


# Comma-separated list of allowed origins, for example:
# http://localhost:8081,http://localhost:19006
CORS_ORIGINS=
