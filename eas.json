{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_API_BASE_URL": "http://127.0.0.1:3333"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_API_BASE_URL": "http://127.0.0.1:3333"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview:device": {
      "extends": "preview",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_API_BASE_URL": "https://CHANGE-ME.example.com"
      },
      "credentialsSource": "local",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6798345216",
        "appleTeamId": "3FPZL5YV7Z"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
